# Copiar a .env y completar. No pongas secretos reales en este archivo.
# Default local: MySQL del docker-compose (puerto 3307).

NODE_ENV=development
PORT=3000

# MySQL local (ola 1). No uses el VPS como default.
DATABASE_URL="mysql://pandora:pandora_dev@127.0.0.1:3307/pandora_dev"

# JWT propios de esta laptop. Distintos a los de Render.
JWT_SECRET=cambiar_jwt_secret_local
REFRESH_TOKEN_SECRET=cambiar_refresh_secret_local
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (en Render: https://pandora-web.onrender.com)
FRONTEND_URL=http://localhost:5173
MOBILE_ORIGIN=

# Captcha. En production la secret es obligatoria.
TURNSTILE_SECRET_KEY=
SKIP_CAPTCHA=false

# Solo local: si el mail falla, el register puede devolver debugOTP.
ALLOW_DEBUG_OTP=false

# Obligatorio para seed o db push contra un host que no sea localhost.
ALLOW_REMOTE_DB=false

# Email (Brevo es el único que usa el código)
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Pandora
ADMIN_EMAIL=

CLOUDINARY_URL=
# No uses un upload preset con OCR/moderation: rompe la subida de fotos.
# En la consola Cloudinary: Add-ons / Upload presets → upload simple a carpeta.

# IA (Groq). AI_PROVIDER=groq ignora OPENAI_API_KEY aunque exista.
# Pegá la key real solo en .env (nunca acá).
# Plan gratis: el mismo modelo para chat y visión (OCR).
AI_PROVIDER="groq"
GROQ_API_KEY=
GROQ_MODEL="qwen/qwen3.6-27b"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"
OPENAI_API_KEY=
